# Copy to .env (docker compose reads it; for local runs export the variables you need).

# Backend: allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Frontend: where Vite proxies /api and /ws (local default http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000
# Frontend: run against the MSW mock API instead of the backend
VITE_USE_MOCKS=false

# Optional — RAG advisor LLM mode (otherwise offline extractive answers are used).
# Leave empty and use `ant auth login`, or set a key here. Never commit a real key.
ANTHROPIC_API_KEY=
